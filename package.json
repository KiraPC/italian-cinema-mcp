{
  "name": "italian-cinema-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local MCP server to compare showtimes across Italian cinema chains (UCI Cinemas, The Space Cinema)",
  "type": "module",
  "bin": {
    "italian-cinema-mcp": "./dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "2.1.3"
  }
}
